{
  "id": "vogelfrei",
  "title": "Vogelfrei",
  "description": "An OSR system of Wounds and Stamina, Weapon Skill and ascending Armour Class. Derived from the Old-School Essentials system for Foundry VTT by Necrotic Gnome and contributors.",
  "version": "0.2.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Illarion Iov",
      "url": "https://github.com/AngrySigma"
    }
  ],
  "esmodules": [
    "dist/vogelfrei.js"
  ],
  "styles": [
    "dist/vogelfrei.css"
  ],
  "packs": [
    {
      "name": "weapons",
      "label": "Weapons",
      "path": "dist/packs/weapons",
      "type": "Item",
      "system": "vogelfrei",
      "flags": {},
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "armour",
      "label": "Armour & Shields",
      "path": "dist/packs/armour",
      "type": "Item",
      "system": "vogelfrei",
      "flags": {},
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "gear",
      "label": "Adventuring Gear",
      "path": "dist/packs/gear",
      "type": "Item",
      "system": "vogelfrei",
      "flags": {},
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "containers",
      "label": "Containers",
      "path": "dist/packs/containers",
      "type": "Item",
      "system": "vogelfrei",
      "flags": {},
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "mounts",
      "label": "Animals & Vehicles",
      "path": "dist/packs/mounts",
      "type": "Item",
      "system": "vogelfrei",
      "flags": {},
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "packFolders": [
    {
      "name": "Equipment",
      "sorting": "m",
      "color": "#5d4037",
      "packs": [
        "weapons",
        "armour",
        "gear",
        "containers",
        "mounts"
      ]
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "dist/lang/en.json"
    }
  ],
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "primaryTokenAttribute": "wounds",
  "secondaryTokenAttribute": "stamina",
  "url": "https://github.com/AngrySigma/vogelfrei-foundry",
  "manifest": "https://github.com/AngrySigma/vogelfrei-foundry/releases/latest/download/system.json",
  "download": "https://github.com/AngrySigma/vogelfrei-foundry/releases/download/0.2.0/system.zip",
  "bugs": "https://github.com/AngrySigma/vogelfrei-foundry/issues",
  "flags": {},
  "hotReload": {
    "extensions": [
      "css"
    ],
    "paths": [
      "dist/"
    ]
  }
}
