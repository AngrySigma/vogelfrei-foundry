{
  "private": true,
  "name": "vogelfrei",
  "version": "0.1.0",
  "description": "Vogelfrei \u2014 an OSR game system for Foundry VTT, derived from Old-School Essentials.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist .types-build",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "build:js": "rollup -c",
    "build:css": "sass src/vogelfrei.scss dist/vogelfrei.css --style=compressed --source-map",
    "build:types": "tsc -p tsconfig.types.json && rollup -c rollup.types.config.js",
    "release:types": "npm run build:types && npm publish ./packages/types",
    "watch": "npm-run-all --parallel watch:*",
    "watch:js": "rollup -c --watch",
    "watch:css": "sass --watch src/vogelfrei.scss dist/vogelfrei.css --source-map",
    "typecheck": "tsc --noEmit",
    "link": "node ./tools/symlink.cjs",
    "unlink": "node ./tools/symlink.cjs -c",
    "lint": "biome check src",
    "format": "biome format --write src",
    "fix": "biome check --write src"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@league-of-foundry-developers/foundry-vtt-types": "13.346.0-beta.20251209192131",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/livereload": "^0.9.2",
    "fs-extra": "^8.1.0",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.55.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.1.0",
    "sass": "^1.97.2",
    "tslib": "^2.4.0",
    "typescript": "^5.9.3",
    "yargs": "^17.3.1"
  }
}
