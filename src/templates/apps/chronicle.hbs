<section class="vf-chronicle-body">

  <section class="calendar phase-{{calendar.phase}}">
    <header class="when">
      {{#if isReferee}}
      <label class="day">
        <span>{{localize "VF.chronicle.Day"}}</span>
        <input type="number" name="day" min="1" step="1" value="{{calendar.day}}" />
      </label>
      {{else}}
      <span class="day">{{localize "VF.chronicle.Day"}} {{calendar.day}}</span>
      {{/if}}
      <span class="watch">{{calendar.watch}}</span>
    </header>

    {{#if calendar.date}}
    <div class="date">
      <span class="civil">{{calendar.date}}</span>
      {{#each calendar.feasts}}
      <span class="feast" data-tooltip="{{localize 'VF.chronicle.FeastToday'}}">
        <i class="fa-solid fa-candle-holder"></i>{{this}}
      </span>
      {{/each}}
    </div>
    {{/if}}

    <div class="daybar">
      {{#if isReferee}}
      <button type="button" class="step" data-action="watchBack" data-tooltip="{{localize 'VF.chronicle.WatchBack'}}">
        <i class="fa-solid fa-chevron-left"></i>
      </button>
      {{/if}}
      <div class="track">
        {{#each segments}}
        <div class="segment {{#if current}}current{{/if}}" data-watch="{{index}}" data-tooltip="{{tooltip}}"
             {{#if ../isReferee}}data-action="setWatch"{{/if}}></div>
        {{/each}}
      </div>
      {{#if isReferee}}
      <button type="button" class="step" data-action="watchForward" data-tooltip="{{localize 'VF.chronicle.WatchForward'}}">
        <i class="fa-solid fa-chevron-right"></i>
      </button>
      {{/if}}
    </div>

    {{#if isReferee}}
    <div class="controls">
      <label class="per-day">
        <span>{{localize "VF.chronicle.WatchesPerDay"}}</span>
        <input type="number" name="watchesPerDay" min="1" max="24" step="1" value="{{calendar.watchesPerDay}}" />
      </label>
      <button type="button" data-action="dayForward">{{localize "VF.chronicle.DayForward"}}</button>
    </div>
    {{/if}}

    {{#if almanac}}
    <details class="almanac">
      <summary>{{localize "VF.chronicle.Almanac"}}</summary>

      <div class="epoch">
        <span>{{localize "VF.chronicle.DayOneFallsOn"}}</span>
        <input type="number" name="epochDay" min="1" max="{{almanac.maxDay}}" step="1" value="{{almanac.day}}"
               data-tooltip="{{localize 'VF.chronicle.EpochDay'}}" />
        <select name="epochMonth" data-tooltip="{{localize 'VF.chronicle.EpochMonth'}}">
          {{#each almanac.months}}
          <option value="{{ordinal}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <input type="number" name="epochYear" step="1" value="{{almanac.year}}"
               data-tooltip="{{localize 'VF.chronicle.EpochYear'}}" />
      </div>
      <p class="hint">{{localize "VF.chronicle.EpochHint"}}</p>

      <h3>{{localize "VF.chronicle.Feasts"}}</h3>
      <ul class="unlist feast-list">
        {{#each almanac.feasts}}
        <li class="feast-entry" data-feast-id="{{id}}">
          <span class="name">{{name}}</span>
          <span class="when">{{when}}</span>
          <button type="button" class="drop" data-action="dropFeast"
                  data-tooltip="{{localize 'VF.chronicle.DropFeast'}}">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </li>
        {{else}}
        <li class="empty">{{localize "VF.chronicle.NoFeasts"}}</li>
        {{/each}}
      </ul>

      <div class="add">
        <input type="text" name="feastName" placeholder="{{localize 'VF.chronicle.FeastPlaceholder'}}" />
        <input type="number" name="feastDay" min="1" max="{{almanac.maxDay}}" step="1" value="1"
               data-tooltip="{{localize 'VF.chronicle.EpochDay'}}" />
        <select name="feastMonth">
          {{#each almanac.feastMonths}}
          <option value="{{ordinal}}">{{label}}</option>
          {{/each}}
        </select>
        <button type="button" data-action="addFeast" data-tooltip="{{localize 'VF.chronicle.AddFeast'}}">
          <i class="fa-solid fa-plus"></i>
        </button>
      </div>
    </details>
    {{/if}}
  </section>

  <button type="button" class="party-line" data-action="openParty" data-tooltip="{{localize 'VF.party.Open'}}">
    <i class="fa-solid fa-users"></i>
    {{#if party.perTurn}}
    <span class="pace">{{party.perTurn.value}}' &middot; {{party.perDay.value}} {{localize "VF.party.Miles"}}</span>
    <span class="who">{{party.perTurn.names}}</span>
    {{else}}
    <span class="pace">{{localize "VF.party.Title"}}</span>
    {{/if}}
  </button>

  {{#if travel}}
  <section class="encounters">
    <h3>{{localize "VF.chronicle.RandomEncounters"}}</h3>
    <div class="rule">
      <label class="terrain">
        <span>{{localize "VF.chronicle.Terrain"}}</span>
        <select name="terrain">
          {{#each travel.terrains}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    <div class="rule">
      <span>{{localize "VF.chronicle.Every"}}</span>
      <input type="number" name="everyWatches" min="1" step="1" value="{{travel.everyWatches}}" />
      <span>{{localize "VF.chronicle.WatchesUnit"}};</span>
      <input type="number" name="travelChance" min="0" max="6" step="1" value="{{travel.chanceIn6}}" />
      <span>{{localize "VF.chronicle.In6"}}</span>
    </div>
    <div class="rule">
      <span>{{localize "VF.chronicle.DistanceLabel"}}</span>
      <input type="text" name="travelDistance" value="{{travel.distance}}" />
    </div>
    <button type="button" data-action="rollTravelEncounter">{{localize "VF.chronicle.CheckNow"}}</button>
  </section>
  {{/if}}

  <section class="delves">
    <h3>{{localize "VF.chronicle.Delves"}}</h3>
    <ul class="unlist delve-list">
      {{#each delves}}
      <li class="delve {{#if penalised}}penalised{{/if}}" data-delve-id="{{id}}">
        <button type="button" class="name" data-action="openDelve">{{name}}</button>
        <span class="turn" data-tooltip="{{localize 'VF.chronicle.TurnsSpent'}}">{{turn}}</span>
        {{#if penalised}}
        <i class="fa-solid fa-triangle-exclamation" data-tooltip="{{localize 'VF.chronicle.RestOverdue'}}"></i>
        {{/if}}
        {{#if ../isReferee}}
        <button type="button" class="drop" data-action="dropDelve" data-tooltip="{{localize 'VF.chronicle.DropDelve'}}">
          <i class="fa-solid fa-xmark"></i>
        </button>
        {{/if}}
      </li>
      {{else}}
      <li class="empty">{{localize "VF.chronicle.NoDelves"}}</li>
      {{/each}}
    </ul>

    {{#if isReferee}}
    <div class="new-delve">
      <input type="text" name="delveName" placeholder="{{localize 'VF.chronicle.NewDelvePlaceholder'}}" />
      <button type="button" data-action="createDelve" data-tooltip="{{localize 'VF.chronicle.NewDelve'}}">
        <i class="fa-solid fa-plus"></i>
      </button>
    </div>
    {{/if}}
  </section>

</section>
